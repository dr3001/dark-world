{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dark World Launcher",
  "version": "1.0.0",
  "identifier": "com.zorionlabs.darkworld.launcher",
  "build": {
    "frontendDist": "..",
    "devUrl": "../index.html",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dark World Launcher",
        "width": 560,
        "height": 640,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https://dark.zorionlabs.net http://127.0.0.1:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
